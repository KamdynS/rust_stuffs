# Build output (shared by every crate in the workspace)
target/

# rustfmt backup files
**/*.rs.bk

# Debug symbols (MSVC on Windows)
*.pdb

# Profiling output
*.profraw
perf.data*
flamegraph.svg

# Local data from later projects (SQLite, Redis-clone append-only file)
*.db
*.db-shm
*.db-wal
*.aof

# Secrets and local config
.env
.env.*
!.env.example

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Note: Cargo.lock is deliberately NOT ignored. This workspace builds
# binaries, so the lockfile should be committed for reproducible builds.
